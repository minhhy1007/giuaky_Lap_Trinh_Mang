      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b_client" value="CLIENT (ỨNG DỤNG KHÁCH)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#000000;fillColor=#FAFAFA;fontFamily=Segoe UI;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="270" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="b_server" value="APPLICATION SERVER (MÁY CHỦ FTP)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#000000;fillColor=#FAFAFA;fontFamily=Segoe UI;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="50" width="430" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="b_data" value="DATA &amp;amp; EXTERNAL (DỮ LIỆU &amp;amp; DỊCH VỤ)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;strokeWidth=2;strokeColor=#000000;fillColor=#FAFAFA;fontFamily=Segoe UI;fontSize=13;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="50" width="270" height="720" as="geometry"/>
        </mxCell>
        <mxCell id="c_ui" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Giao diện Người dùng (Presentation UI)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Java Swing Desktop: LoginFrame,&lt;br&gt;MainFrame, AdminDashboard, Dialogs)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="230" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="c_client_svc" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Dịch vụ Khách &amp;amp; Socket (FtpClientService)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Quản lý phiên, đóng gói lệnh FTP,&lt;br&gt;TCPClient &amp;amp; Binary Transfer Stream)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c_tcp_conn" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Bộ Tiếp nhận &amp;amp; Đa luồng (TCPServer)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(ServerSocket Port 6789, Thread Pool,&lt;br&gt;ClientHandler, ProtocolInputStream)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="105" width="380" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="c_controller" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Bộ Điều khiển Giao thức (CommandHandler)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Phân tích &amp;amp; điều phối lệnh FTP: AUTH, FILE,&lt;br&gt;DIR, QUOTA, SHARE, ORDER, PAYMENT)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="235" width="380" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="c_auth_sec" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Xác thực &amp;amp; Bảo mật (Security &amp;amp; Auth)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Băm mật khẩu SHA-256 + Salt,&lt;br&gt;Phân quyền USER / ADMIN, Token Guard)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="365" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c_storage_mgr" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Quản lý Tập tin &amp;amp; Quota (StorageManager)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Cô lập Sandbox Chroot, Anti Path Traversal,&lt;br&gt;Kiểm soát Quota, Dọn dẹp tệp tạm .tmp)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="490" width="380" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="c_dao" value="&amp;laquo;component&amp;raquo;&lt;br&gt;&lt;b&gt;Tầng Truy xuất Dữ liệu (Data Access - DAO)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(UserDAO, FileDAO, ShareDAO, OrderDAO,&lt;br&gt;LogDAO &amp;amp; JDBC Connection Pool)&lt;/i&gt;" style="shape=module;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="620" width="380" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="c_mysql" value="&amp;laquo;database&amp;raquo;&lt;br&gt;&lt;b&gt;Cơ sở Dữ liệu (MySQL Database)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Port 3306 - ACID &amp;amp; Ràng buộc toàn vẹn:&lt;br&gt;users, files, file_shares, orders,&lt;br&gt;plans, payments, transfer_logs)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="875" y="115" width="220" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="c_fs" value="&amp;laquo;filesystem&amp;raquo;&lt;br&gt;&lt;b&gt;Hệ thống Tệp Lưu trữ (Storage Sandbox)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Thư mục vật lý: storage/&amp;lt;username&amp;gt;/&lt;br&gt;Phân vùng độc lập theo người dùng)&lt;/i&gt;" style="shape=folder;fontStyle=1;tabWidth=90;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="875" y="375" width="220" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="c_payment_ext" value="&amp;laquo;external service&amp;raquo;&lt;br&gt;&lt;b&gt;Cổng Thanh toán (VietQR Simulator)&lt;/b&gt;&lt;br&gt;&lt;i&gt;(Sinh mã QR, mô phỏng Webhook&lt;br&gt;xác nhận chuyển khoản &amp;amp; kích hoạt gói)&lt;/i&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;strokeWidth=1.8;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Segoe UI;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="875" y="595" width="220" height="110" as="geometry"/>
